RewriteEngine On
# RewriteBase /

# Prevent directory listing
Options -Indexes -MultiViews

# Ensure trailing slashes don't break logic (redirect /page/ to /page)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ $1 [L,R=301]

# Core Redirects for Detail Pages
# Note: No leading slash in the pattern, and [L,QSA] to handle parameters
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^destination/([^/]+)$ public/destination-details.php?slug=$1 [L,QSA,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^package/([^/]+)$ public/package-details.php?slug=$1 [L,QSA,NC]

# Primary Page Mappings
RewriteRule ^destinations$ public/destinations.php [L,QSA,NC]
RewriteRule ^packages$ public/packages.php [L,QSA,NC]
RewriteRule ^about$ public/about.php [L,QSA,NC]
RewriteRule ^gallery$ public/gallery.php [L,QSA,NC]
RewriteRule ^car-rentals$ public/car-rentals.php [L,QSA,NC]
RewriteRule ^contact$ public/contact.php [L,QSA,NC]
RewriteRule ^thank-you$ public/thank-you.php [L,QSA,NC]
RewriteRule ^privacy-policy$ public/privacy-policy.php [L,QSA,NC]
RewriteRule ^terms-conditions$ public/terms-conditions.php [L,QSA,NC]
RewriteRule ^index$ index.php [L,QSA,NC]

# Error Pages
# Error Pages - Note: Paths are absolute to server root. 
# On localhost subdirectory, these might display default browser errors or need adjustment (e.g., /zubitours/public/404.php)
ErrorDocument 404 /public/404.php
ErrorDocument 500 /public/505.php
